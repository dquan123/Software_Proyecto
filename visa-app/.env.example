DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=visa_db
# Local Docker can use development to store uploads in the local Docker volume.
# AWS production should use production and real R2 variables.
NODE_ENV=development
# Required in production. Replace this placeholder with a unique, cryptographically random secret.
SESSION_SECRET=replace_with_a_unique_long_random_secret
# Docker production: use /api so Nginx proxies requests to the backend.
FRONTEND_API_URL=/api
# Local Vite dev only. If empty, the frontend uses the current host and VITE_API_PORT.
VITE_API_URL=
VITE_API_PORT=3000
# Browser origins allowed to call the API directly. Values are comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://visa-app.duckdns.org,https://visa-app.duckdns.org

# Cuentas de desarrollo:
# init.sql crea las cuentas de prueba del README en bases nuevas.
# En NODE_ENV=development el backend tambien asegura esas cuentas al arrancar.
# Numero de WhatsApp del asesor en formato internacional, solo digitos.
# Ejemplo Guatemala: 50255555555
VITE_WHATSAPP_PHONE=
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your_r2_bucket
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Recordatorios por email. Por defecto se registran como dry-run y no se envian correos reales.
# Usa disabled para apagar la ejecucion o send cuando exista un proveedor real inyectado/configurado.
EMAIL_REMINDERS_MODE=dry_run
